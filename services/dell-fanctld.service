[Unit]
Description=Dell fan control loop
After=dell-bios-fan-control.service
Requires=dell-bios-fan-control.service

[Service]
Type=simple
ExecStartPre=/bin/sleep 2
ExecStart=/usr/local/sbin/dell-fanctld
Restart=always

# The loop needs about 4-8 MB. Above 20 MB, the kernel reclaims memory
# and slows the service down. MemoryHigh never kills the service.
MemoryHigh=20M

[Install]
WantedBy=multi-user.target
