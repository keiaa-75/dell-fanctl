#!/usr/bin/env bash

# paths can be overridden, e.g. by tests
FANCTL_CONF=${FANCTL_CONF:-/usr/local/etc/dell-fanctl.conf}
FANCTL_LIB=${FANCTL_LIB:-/usr/local/lib/dell-fanctl}
HWMON_ROOT=${HWMON_ROOT:-/sys/class/hwmon}

source "$FANCTL_LIB/parse-config.sh" || { echo "ERROR: Could not load $FANCTL_LIB/parse-config.sh."; exit 1; }
source "$FANCTL_LIB/config.sh" || { echo "ERROR: Could not load $FANCTL_LIB/config.sh."; exit 1; }

check_deps() {
    # i8kfan is used to set fan speeds
    # dell_smm_hwmon exposes the interface
    I8KFAN=$(command -v i8kfan) || { echo "ERROR: i8kfan not found."; exit 1; }
    lsmod | grep -q dell_smm_hwmon || { echo "ERROR: dell_smm_hwmon not loaded."; exit 1; }
}

find_temp_input() {
    local hwmon name

    for hwmon in "$HWMON_ROOT"/hwmon*; do
        name=$(cat "$hwmon/name" 2>/dev/null)

        case "$name" in
            coretemp)
                # coretemp is preferred
                # no need to look further
                HWMON_PATH="$hwmon"
                return ;;
            dell_smm)
                # acceptable fallback
                # keep looping in case coretemp appears later
                HWMON_PATH="$hwmon" ;;
        esac
    done

    [[ -n "$HWMON_PATH" ]] || { echo "ERROR: No suitable temperature sensor found."; exit 1; }
}

find_fans() {
    local left right
    # i8kfan outputs two values
    # absent fans are reported as -1
    read -r left right < <($I8KFAN)
    LEFT_FAN=$(( left != -1 ))
    RIGHT_FAN=$(( right != -1 ))
}

get_temp() {
    local file reading raw=""

    for file in "$HWMON_PATH"/temp*_input; do
        # skip files that can't be read or don't hold a whole number
        { read -r reading < "$file"; } 2> /dev/null || continue
        [[ "$reading" =~ ^[0-9]+$ ]] || continue

        if [[ -z "$raw" || "$reading" -gt "$raw" ]]; then
            raw=$reading
        fi
    done

    if [[ -z "$raw" ]]; then
        echo "WARNING: Could not read temperature; skipping iteration."
        return 1
    fi

    local celsius=$(( raw / 1000 ))

    # sanity check: reject implausible values
    if [[ "$celsius" -lt 0 || "$celsius" -gt 105 ]]; then
        echo "WARNING: Implausible temperature reading (${celsius}°C); skipping iteration."
        return 1
    fi

    TEMP=$celsius
}

# Prints the fan speed to use for a temperature, given the current speed.
# Steps up as soon as a threshold is reached, but only steps down once the
# temperature has dropped HYST_OFFSET degrees below it, so the fans don't
# keep switching around a threshold. Prints the current speed if nothing changes.
next_speed() {
    local temp=$1 current=$2

    if [[ "$temp" -ge "$TEMP_HIGH" ]]; then
        NEXT_SPEED=2
    elif [[ "$temp" -lt "$(( TEMP_HIGH - HYST_OFFSET ))" && "$current" -eq 2 ]]; then
        NEXT_SPEED=1
    elif [[ "$temp" -ge "$TEMP_LOW" && "$current" -lt 1 ]]; then
        NEXT_SPEED=1
    elif [[ "$current" -lt 0 ]]; then
        NEXT_SPEED=0
    elif [[ "$temp" -lt "$(( TEMP_LOW - HYST_OFFSET ))" && "$current" -eq 1 ]]; then
        NEXT_SPEED=0
    else
        NEXT_SPEED=$current
    fi
}

set_fan_speed() {
    local speed=$1

    # only issue command if speed is actually changing
    if [[ "$speed" -ne "$CURRENT_SPEED" ]]; then
        local left_arg=$(( LEFT_FAN ? speed : 0 ))
        local right_arg=$(( RIGHT_FAN ? speed : 0 ))
        $I8KFAN "$left_arg" "$right_arg" > /dev/null
        CURRENT_SPEED=$speed
        echo "INFO: Fan speed set to $speed at ${TEMP}°C."
    fi
}

cleanup() {
    echo "INFO: Shutting down; setting fans to high."
    set_fan_speed 2
}

main() {
    load_config "$FANCTL_CONF"

    check_deps
    find_temp_input
    find_fans

    # BIOS fan control stays off after the script stops,
    # so leave the fans at high to stay safe under any load
    # SIGTERM only exits; the EXIT trap then runs cleanup once
    trap cleanup EXIT
    trap 'exit 0' SIGTERM

    local fan_count=$(( LEFT_FAN + RIGHT_FAN ))
    echo "INFO: Starting. Sensor: $(cat "$HWMON_PATH/name"). Fans: $fan_count."
    echo "INFO: Config: TEMP_LOW=${TEMP_LOW}°C, TEMP_HIGH=${TEMP_HIGH}°C, HYST_OFFSET=${HYST_OFFSET}°C, POLL_INTERVAL=${POLL_INTERVAL}s."

    local CURRENT_SPEED=-1

    while true; do
        # skip fan control for this iteration on a bad temperature read
        if get_temp; then
            next_speed "$TEMP" "$CURRENT_SPEED"
            set_fan_speed "$NEXT_SPEED"
        fi

        # run sleep in the background and wait for it,
        # so a SIGTERM is handled right away instead of after the sleep
        sleep "$POLL_INTERVAL" &
        wait $!
    done
}

# run only when executed, not when sourced by tests
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main
fi